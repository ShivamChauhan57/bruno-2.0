<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bruno_description</name>
  <version>0.0.0</version>
  <description>URDF chassis model for Bruno 2.0 (base_footprint, base_link, laser_frame, sonar frames) and its robot_state_publisher launch file</description>
  <maintainer email="shivamchauhan3957@gmail.com">bruno</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
