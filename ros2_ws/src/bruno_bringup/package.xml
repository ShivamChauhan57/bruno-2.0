<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bruno_bringup</name>
  <version>0.0.0</version>
  <description>Master bringup launch file for Bruno 2.0: robot_state_publisher, LD14P LiDAR driver, ESP32 base controller bridge, and rf2o laser odometry</description>
  <maintainer email="shivamchauhan3957@gmail.com">bruno</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>bruno_description</exec_depend>
  <exec_depend>ldlidar_stl_ros2</exec_depend>
  <exec_depend>bruno_base</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
